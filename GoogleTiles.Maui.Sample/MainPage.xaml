<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:gt="clr-namespace:GoogleTiles.Maui.Controls;assembly=GoogleTiles.Maui"
             xmlns:vm="clr-namespace:GoogleTiles.Maui.Sample.ViewModels"
             x:DataType="vm:MainViewModel"
             x:Class="GoogleTiles.Maui.Sample.MainPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <gt:GoogleTilesView Grid.Row="0" ZoomLevel="15" Center="40.7608, -111.8910" MapType="{Binding MapType}" MapTheme="{Binding Theme}" MapRotation="{Binding Rotation}" x:Name="GTView"/>
        <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="5">
            <Button Text="Cycle Map Type" Command="{Binding CycleMapTypeCommand}"/>
            <Button Text="Toggle Theme" Command="{Binding ToggleNightMode}" IsEnabled="{Binding IsNightEnabled}"/>
            <Button Text="Add Test Pin" Command="{Binding AddTestPin}" CommandParameter="{Reference GTView}"/>
            <Button Text="Increase Rotation" Command="{Binding IncreaseRotation}"/>
            <Label Text="Current Rotation: "/>
            <Label Text="{Binding Rotation}"/>
            <Entry x:Name="RotationEntry" Text="{Binding Rotation, Mode=TwoWay}"/>
            <Button Text="Add Test Path" Command="{Binding AddTestPolyline}" CommandParameter="{Reference GTView}"/>
            <Button Text="Add Incremental Path" Command="{Binding AddTestPathIncremental}" CommandParameter="{Reference GTView}"/>
        </StackLayout>
    </Grid>
</ContentPage>
